{
  "format": "html",
  "recognize": "ul#menu",
  "items": "ul#menu > li",
  "allowEmpty": true,
  "timeFormat": "HH:mm:ss",
  "fields": {
    "title": {
      "select": ".info span"
    },
    "time": {
      "select": ".info time",
      "read": "attr",
      "attribute": "datetime"
    },
    "category": {
      "read": "attr",
      "attribute": "data-category"
    }
  },
  "servers": {
    "items": "a[href*='?r=']",
    "fields": {
      "name": {
        "select": "span"
      },
      "url": {
        "read": "attr",
        "attribute": "href",
        "transforms": [
          {
            "op": "query",
            "value": "r"
          },
          {
            "op": "base64"
          },
          {
            "op": "absolute"
          }
        ]
      }
    }
  }
}
