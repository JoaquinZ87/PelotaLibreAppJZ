<?xml version="1.0" encoding="utf-8"?>
<!-- Banner del launcher de Android TV. Debe ser 320x180.
     PLACEHOLDER: reemplazar por un PNG 320x180 con el nombre de la app para que
     el tile del home se vea prolijo (los vectores no renderizan texto). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Fondo -->
    <path
        android:fillColor="#0B0B0F"
        android:pathData="M0,0 h320 v180 h-320 z" />

    <!-- Pelota (círculo celeste con reflejo) -->
    <path
        android:fillColor="#00B0F0"
        android:pathData="M70,90 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0 z" />
    <path
        android:fillColor="#7FD8FA"
        android:pathData="M58,74 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 z" />

    <!-- Barra de acento -->
    <path
        android:fillColor="#39D98A"
        android:pathData="M140,140 h150 v8 h-150 z" />
</vector>
