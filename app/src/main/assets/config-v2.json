  "recipes": {
    "menuR": {
      "format": "html",
      "recognize": "ul.menu",
      "items": "ul.menu > li",
      "allowEmpty": true,
      "fields": {
        "title": {
          "select": "a",
          "read": "ownText"
        },
        "time": {
          "select": "a span.t"
        },
        "category": {
          "read": "attr",
          "attribute": "class"
        }
      },
      "servers": {
        "items": "a[href*='?r=']",
        "fields": {
          "name": {
            "read": "ownText"
          },
          "quality": {
            "select": "span"
          },
          "url": {
            "read": "attr",
            "attribute": "href",
            "transforms": [
              {
                "op": "query",
                "value": "r"
              },
              {
                "op": "base64"
              },
              {
                "op": "absolute"
              }
            ]
          }
        }
      }
    },
    "menu2": {
      "format": "html",
      "recognize": "ul#menu",
      "items": "ul#menu > li",
      "allowEmpty": true,
      "timeFormat": "HH:mm:ss",
      "fields": {
        "title": {
          "select": ".info span"
        },
        "time": {
          "select": ".info time",
          "read": "attr",
          "attribute": "datetime"
        },
        "category": {
          "read": "attr",
          "attribute": "data-category"
        }
      },
      "servers": {
        "items": "a[href*='?r=']",
        "fields": {
          "name": {
            "select": "span"
          },
          "url": {
            "read": "attr",
            "attribute": "href",
            "transforms": [
              {
                "op": "query",
                "value": "r"
              },
              {
                "op": "base64"
              },
              {
                "op": "absolute"
              }
            ]
          }
        }
      }
    },
    "eventsJson": {
      "format": "json",
      "recognize": "$.events",
      "items": "$.events[*]",
      "allowEmpty": true,
      "timeFormat": "HH:mm:ss",
      "fields": {
        "title": {
          "select": "$.title"
        },
        "time": {
          "select": "$.time"
        },
        "date": {
          "select": "$.date"
        },
        "category": {
          "select": "$.sport"
        }
      },
      "servers": {
        "items": "$.embeds[*]",
        "fields": {
          "name": {
            "select": "$.name"
          },
          "quality": {
            "select": "$.lang"
          },
          "url": {
            "select": "$.iframe"
          }
        }
      }
    },
    "wpjson": {
      "format": "json",
      "recognize": "$.data",
      "items": "$.data[*]",
      "allowEmpty": true,
      "fields": {
        "title": {
          "select": "$.title"
        },
        "time": {
          "select": "$.time_raw"
        },
        "category": {
          "select": "$.country"
        }
      },
      "servers": {
        "items": "$.channels[*]",
        "fields": {
          "name": {
            "select": "$.name"
          },
          "url": {
            "select": "$.stream_url"
          }
        }
      },
      "timeFormat": "HH:mm:ss"
    },
    "strapi": {
      "format": "json",
      "recognize": "$.data",
      "items": "$.data[*].attributes",
      "allowEmpty": true,
      "timeFormat": "HH:mm:ss",
      "fields": {
        "title": {
          "select": "$.diary_description"
        },
        "time": {
          "select": "$.diary_hour"
        }
      },
      "servers": {
        "items": "$.embeds.data[*].attributes",
        "fields": {
          "name": {
            "select": "$.embed_name"
          },
          "quality": {
            "select": "$.idioma"
          },
          "url": {
            "select": "$.embed_iframe",
            "transforms": [
              {
                "op": "query",
                "value": "r"
              },
              {
                "op": "base64"
              },
              {
                "op": "absolute"
              }
            ]
          }
        }
      }
    },
    "rows": {
      "format": "html",
      "recognize": ".wrap .tabla",
      "items": "div.match",
      "allowEmpty": true,
      "groupByTitle": true,
      "fields": {
        "title": {
          "select": "span.name"
        },
        "time": {
          "select": "span.time"
        }
      },
      "servers": {
        "items": "div.chans a[href]",
        "needsResolve": true,
        "fields": {
          "name": {
            "read": "text"
          },
          "url": {
            "read": "attr",
            "attribute": "href",
            "transforms": [
              {
                "op": "absolute"
              }
            ]
          }
        }
      }
    },
    "iframe": {
      "format": "html",
      "url": {
        "select": "iframe#plyr, iframe#streamIframe, iframe#embedIframe, .player iframe, #player iframe, #playerContainer iframe",
        "read": "attr",
        "attribute": "src"
      }
    },
    "cards": {
      "format": "html",
      "recognize": ".cards-container",
      "items": ".cards-container .card",
      "allowEmpty": true,
      "fields": {
        "title": {
          "select": "h3"
        },
        "category": {
          "select": "img",
          "read": "attr",
          "attribute": "src"
        }
      },
      "servers": {
        "items": "a[href]:not([href='#'])",
        "needsResolve": true,
        "fields": {
          "url": {
            "read": "attr",
            "attribute": "href",
            "transforms": [
              {
                "op": "absolute"
              }
            ]
          }
        }
      }
    }
  }
